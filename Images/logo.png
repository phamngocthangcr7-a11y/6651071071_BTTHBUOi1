<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 260 60" width="260" height="60">
  <defs>
    <linearGradient id="shield_g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4a6b22"/>
      <stop offset="100%" stop-color="#2a4014"/>
    </linearGradient>
  </defs>
  <!-- Shield Icon -->
  <g transform="translate(10, 5)">
    <polygon points="25,2 48,10 48,32 25,48 2,32 2,10" fill="url(#shield_g)" stroke="#d97706" stroke-width="2"/>
    <circle cx="25" cy="24" r="14" fill="none" stroke="#f8fafc" stroke-width="1.5" stroke-dasharray="3 2"/>
    <line x1="25" y1="10" x2="25" y2="38" stroke="#d97706" stroke-width="2"/>
    <line x1="11" y1="24" x2="39" y2="24" stroke="#d97706" stroke-width="2"/>
    <circle cx="25" cy="24" r="4" fill="#ef4444"/>
  </g>
  <!-- Brand Text -->
  <text x="68" y="27" font-family="'Chakra Petch', 'Impact', sans-serif" font-size="20" font-weight="800" fill="#1c2d10" letter-spacing="1.5">AEGIS TACTICAL</text>
  <text x="69" y="44" font-family="'Cairo', 'Segoe UI', sans-serif" font-size="10.5" font-weight="700" fill="#d97706" letter-spacing="3">GLOBAL DEFENSE SYSTEMS</text>
</svg>